#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$repo"
./scripts/cargo fmt --check
./scripts/cargo clippy --all-targets --all-features -- -D warnings
./scripts/cargo clippy --all-targets --no-default-features -- -D warnings
./scripts/cargo test --all-targets --all-features
./scripts/cargo test --release --all-targets --all-features
./scripts/cargo test --release --all-targets --no-default-features
./scripts/cargo test --doc --all-features
cd benchmarks/go
test -z "$(gofmt -l *.go ../../scripts/generate-string-casing.go)"
GOEXPERIMENT= ../../scripts/go test -mod=readonly ./...
GOEXPERIMENT=simd ../../scripts/go test -mod=readonly ./...
GOEXPERIMENT=simd ../../scripts/go vet ./...
../../scripts/go vet ../../scripts/generate-string-casing.go
