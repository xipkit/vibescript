#!/bin/sh
# Runs the local validation gate. --with-go also runs the Go comparison
# harness's own tests, which need the Go toolchain.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$repo"
with_go=0
for arg in "$@"; do
  case "$arg" in
    --with-go) with_go=1 ;;
    *) echo "usage: scripts/check [--with-go]" >&2; exit 2 ;;
  esac
done
./scripts/cargo fmt --check
./scripts/cargo clippy --workspace --all-targets --all-features -- -D warnings
./scripts/cargo clippy --workspace --all-targets --no-default-features -- -D warnings
./scripts/cargo test --workspace --all-targets --all-features
./scripts/cargo test --workspace --release --all-targets --all-features
./scripts/cargo test --workspace --release --all-targets --no-default-features
./scripts/cargo test --workspace --doc --all-features
python3 scripts/golden.py
if [ "$with_go" = 1 ]; then
  cd benchmarks/go
  test -z "$(gofmt -l *.go ../../scripts/generate-string-casing.go)"
  GOEXPERIMENT= ../../scripts/go test -mod=readonly ./...
  GOEXPERIMENT=simd ../../scripts/go test -mod=readonly ./...
  GOEXPERIMENT=simd ../../scripts/go vet ./...
  ../../scripts/go vet ../../scripts/generate-string-casing.go
fi
