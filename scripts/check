#!/bin/sh
# Runs the local validation gate.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$repo"
if [ "$#" -gt 0 ]; then
  echo "usage: scripts/check" >&2
  exit 2
fi
./scripts/cargo fmt --check
./scripts/cargo clippy --workspace --all-targets --all-features -- -D warnings
./scripts/cargo clippy --workspace --all-targets --no-default-features -- -D warnings
./scripts/cargo test --workspace --all-targets --all-features
./scripts/cargo test --workspace --profile gate --all-targets --all-features
./scripts/cargo test --workspace --profile gate --all-targets --no-default-features
./scripts/cargo test --workspace --doc --all-features
python3 scripts/golden.py
