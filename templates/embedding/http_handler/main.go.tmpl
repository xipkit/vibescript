package main

import (
	"encoding/json"
	"net/http"
	"time"

	"github.com/mgomes/vibescript/vibes"
	"github.com/mgomes/vibescript/vibes/value"
)

type service struct {
	script *vibes.Script
}

func newService() (*service, error) {
	engine, err := vibes.NewEngine(vibes.Config{
		StepQuota:        20_000,
		MemoryQuotaBytes: 256 << 10,
		RecursionLimit:   32,
		StrictEffects:    true,
	})
	if err != nil {
		return nil, err
	}

	script, err := engine.Compile(`
def run(input: hash) -> hash
  {
    id: input[:id],
    status: "ok",
  }
end
`)
	if err != nil {
		return nil, err
	}

	return &service{script: script}, nil
}

func (s *service) handle(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()

	result, err := s.script.Call(ctx, "run", []value.Value{
		value.NewHash(map[string]value.Value{
			"id": value.NewString(r.URL.Query().Get("id")),
		}),
	}, vibes.CallOptions{
		Globals: map[string]value.Value{
			"request_id": value.NewString(r.Header.Get("X-Request-Id")),
		},
	})
	if err != nil {
		http.Error(w, err.Error(), http.StatusBadRequest)
		return
	}

	_ = json.NewEncoder(w).Encode(map[string]any{
		"result": result.String(),
	})
}

func newServer(svc *service) *http.Server {
	mux := http.NewServeMux()
	mux.HandleFunc("/run", svc.handle)
	return &http.Server{
		Addr:              ":8080",
		Handler:           mux,
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       10 * time.Second,
		WriteTimeout:      10 * time.Second,
		IdleTimeout:       60 * time.Second,
	}
}

func main() {
	svc, err := newService()
	if err != nil {
		panic(err)
	}
	if err := newServer(svc).ListenAndServe(); err != nil {
		panic(err)
	}
}
