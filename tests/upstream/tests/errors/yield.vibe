def yield_without_block(&block: int -> int) -> int
  yield(42)
end

def yield_in_nested(&block: int) -> array<int>
  [1].each { |x|
    yield(x)
  }
end

def double_yield(&block: int -> int) -> int
  yield(1)
  yield(2)
end

def run -> { count: int }
  count = 0
  double_yield { |x|
    count = count + x
  }
  { count: count }
end
