def requires_one(x: int) -> int
  x
end

def requires_two(a: int, b: int) -> int
  a + b
end

def with_default(x: int, y: int = 10) -> int
  x + y
end

def with_typed_keyword(*, name: string, score: int = 0) -> string
  name
end

def too_few_args -> int
  requires_two(1)
end

def too_many_args -> int
  requires_one(1, 2)
end

def run -> { a: int, b: int, c: string, d: string }
  a = with_default(5)
  b = with_default(5, 20)
  c = with_typed_keyword(name: "test")
  d = with_typed_keyword(name: "test", score: 42)
  { a: a, b: b, c: c, d: d }
end
