# Collections, sizing, and indexing fixture

def first_initial(name: string) -> string
  name.split(" ").fetch(0)[0].as(string)
end

def sizes(arr: array<string>) -> { arr: int, str: int }
  { arr: arr.length, str: "hello".length }
end

def run -> { initial: string, sizes: { arr: int, str: int } }
  names = ["Ada Lovelace", "Grace Hopper"]
  {
    initial: first_initial(names.fetch(0)),
    sizes: sizes(names)
  }
end
