# Loop patterns

def sum_matrix(matrix: array<array<int>>) -> int
  total = 0
  for row in matrix
    for cell in row
      total = total + cell
    end
  end
  total
end

def flatten_once(values: array<array<int>>) -> array<int>
  out: array<int> = []
  for arr in values
    for v in arr
      out = out + [v]
    end
  end
  out
end

def countdown(from: int) -> array<int>
  out: array<int> = []
  for i in from..0
    out = out + [i]
  end
  out
end

def run -> { countdown: array<int>, flat: array<int>, sum: int }
  matrix = [[1, 2], [3, 4]]
  {
    sum: sum_matrix(matrix),
    flat: flatten_once(matrix),
    countdown: countdown(3)
  }
end
