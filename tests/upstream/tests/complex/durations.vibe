# Duration-heavy helpers

def window_start(days_back: int) -> time
  days_back.days.before(Time.now)
end

def window_end(hours_forward: int) -> time
  hours_forward.hours.after(Time.now)
end

def span_seconds(start: time, finish: time) -> int
  (finish - start).floor
end

def readable_window(days_back: int, hours_forward: int) -> string
  start = window_start(days_back)
  finish = window_end(hours_forward)
  start_str = start.format("2006-01-02 15:04:05")
  finish_str = finish.format("2006-01-02 15:04:05")
  start_str + " -> " + finish_str
end

def shift_series(timestamps: array<int>, delta: duration) -> array<string>
  timestamps.map { |ts|
    delta.after(Time.at(ts)).format("2006-01-02T15:04:05Z")
  }
end

def run -> { iso: string, readable: string, shifted: array<string>, span: int }
  start = Time.at(0)
  finish = 90.minutes.after(start)
  delta = Duration.build(seconds: finish - start)
  {
    shifted: shift_series([0, 1800], 1800.seconds),
    span: span_seconds(start, finish),
    iso: delta.iso8601,
    readable: readable_window(1, 2)
  }
end
