def twice(&block: () -> int) -> int
  yield
  yield
end

def with_value(val: int, &block: int -> int) -> int
  yield(val)
end

def transform(a: int, b: int, &block: int -> int) -> int
  yield(a) + yield(b)
end

def run -> { count: int, doubled: int, sum: int }
  count = 0
  twice {
    count = count + 1
  }

  doubled = with_value(21) { |x|
    x * 2
  }

  sum = transform(3, 4) { |n|
    n * 10
  }

  { count: count, doubled: doubled, sum: sum }
end
