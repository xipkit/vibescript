# String utilities

def slugify(text: string) -> string
  text.strip.downcase.split(" ").join("-")
end

def initials(name: string) -> string
  parts = name.split(" ")
  out = ""
  for p in parts
    out = out + p[0].as(string)
  end
  out
end

def titleize(name: string) -> string
  name.strip
end

def wrap(text: string, width: int) -> array<string>
  words = text.split(" ")
  line = ""
  lines: array<string> = []
  words.each { |w|
    if line == ""
      line = w
    elsif (line.length + 1 + w.length) <= width
      line = line + " " + w
    else
      lines = lines + [line]
      line = w
    end
  }
  if line != ""
    lines = lines + [line]
  end
  lines
end

def run -> { initials: string, slug: string, title: string, wrapped: array<string> }
  {
    slug: slugify(" Hello World "),
    initials: initials("Ada Lovelace"),
    title: titleize("  vibes  "),
    wrapped: wrap("one two three four", 7)
  }
end
