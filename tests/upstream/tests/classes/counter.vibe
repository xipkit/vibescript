class Counter
  @@instances: int = 0

  def initialize
    @@instances = @@instances + 1
  end

  def self.instances -> int
    @@instances
  end
end

def run -> { after: int, before: int }
  before = Counter.instances
  Counter.new
  Counter.new
  Counter.new
  after = Counter.instances
  { before: before, after: after }
end
