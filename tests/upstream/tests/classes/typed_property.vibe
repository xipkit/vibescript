class Account
  property owner: string
  getter balance: int
  setter note: string

  def initialize(owner: string)
    @owner = owner
    @balance = 0
    @note = ""
  end

  def deposit(amount: int) -> int
    @balance = @balance + amount
    @balance
  end

  def annotate(text: string) -> string
    self.note = text
    @note
  end
end

def run -> { balance: int, note: string, owner: string }
  a = Account.new("ada")
  a.owner = "Ada Lovelace"
  deposited = a.deposit(100)
  note = a.annotate("primary")
  { owner: a.owner, balance: deposited, note: note }
end
