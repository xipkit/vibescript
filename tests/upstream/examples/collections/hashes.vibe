# vibe: 1.0

def make_player(name: string, goal: int) -> { goal: int, name: string, raised: int, status: string }
  {
    name: name,
    goal: goal,
    raised: 0,
    status: "active"
  }
end

def mark_complete(player: { name: string, status: string }) -> { name: string, status: string }
  player["status"] = "complete"
  player
end

def total_with_bonus(row: { raised: int }, bonus: int) -> int
  row["raised"] + bonus
end

def nested_lookup(record: { meta: { tag: string } }) -> string
  record["meta"]["tag"]
end
