# vibe: 1.0

def head(values)
  values[0]
end

def tail(values)
  values[1]
end

def build_matrix(x, y)
  [[x, y], [y, x]]
end

def replace_first(values, value)
  values[0] = value
  values
end

def update_without_aliasing(values, value)
  original = values
  values[0] = value
  { updated: values, original: original }
end
