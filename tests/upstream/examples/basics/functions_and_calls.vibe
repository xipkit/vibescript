# vibe: 1.0

def greet(name: string) -> string
  "hello " + name
end

def decorated_greeting(name: string) -> string
  message = greet(name)
  "[" + message + "]"
end

def sum_three(a: int, b: int, c: int) -> int
  add_two = a + b
  add_two + c
end

def max_value(a: int, b: int) -> int
  if a > b
    a
  else
    b
  end
end
