# vibe: 1.0

def add_numbers(a: int, b: int) -> int
  a + b
end

def combine_strings(first: string, second: string) -> string
  first + " " + second
end

def negate(value: int) -> int
  -value
end

def truth_table(flag: bool) -> bool
  if flag
    true
  else
    false
  end
end

def mix_literals -> { answer: int, flags: array<bool?>, quote: string, ratio: float }
  {
    answer: 42,
    ratio: 3.75,
    quote: "keep going",
    flags: [true, false, nil]
  }
end

def run -> { add: int, combine: string, literals: { answer: int, flags: array<bool?>, quote: string, ratio: float }, negate: int, truth: bool }
  {
    add: add_numbers(10, 25),
    combine: combine_strings("hello", "world"),
    negate: negate(7),
    truth: truth_table(true),
    literals: mix_literals
  }
end
