# vibe: 1.0

def inclusive_range_sum(start: int, finish: int) -> int
  total = 0
  for value in start..finish
    total = total + value
  end
  total
end

def exclusive_range_sum(start: int, finish: int) -> int
  total = 0
  for value in start...finish
    total = total + value
  end
  total
end

def descending_range_collect(start: int, finish: int) -> string
  output = ""
  for value in start..finish
    if output == ""
      output = value.to_s
    else
      output = "#{output},#{value}"
    end
  end
  output
end

def range_even_numbers(start: int, finish: int) -> string
  output = ""
  for value in start..finish
    if value % 2 == 0
      if output == ""
        output = value.to_s
      else
        output = "#{output},#{value}"
      end
    end
  end
  output
end

def run -> { descending: string, evens: string, inclusive_sum: int }
  {
    inclusive_sum: inclusive_range_sum(1, 10),
    descending: descending_range_collect(5, 1),
    evens: range_even_numbers(1, 20)
  }
end
