# vibe: 1.0

def permission_keys
  [:read, :write, :delete]
end

def fetch_hash_key(record, key)
  record[key]
end

def normalized_hash_view(record)
  {
    same_entry: record[:name] == record["name"],
    keys: record.keys
  }
end

def run
  record = { name: "Alice", role: "coach" }
  {
    keys: permission_keys,
    fetched: fetch_hash_key(record, :name),
    normalized: normalized_hash_view(record)
  }
end
