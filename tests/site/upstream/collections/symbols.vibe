# vibe: 1.0

def permission_keys -> array<symbol>
  [:read, :write, :delete]
end

def fetch_hash_key(record: hash<string, string>, key: symbol) -> string?
  record[key.to_s]
end

def normalized_hash_view(record: { name: string, role: string }) -> { keys: array<string>, same_entry: bool }
  {
    same_entry: record["name"] == record["name"],
    keys: record.keys
  }
end

def run -> { fetched: string?, keys: array<symbol>, normalized: { keys: array<string>, same_entry: bool } }
  record = { name: "Alice", role: "coach" }
  {
    keys: permission_keys,
    fetched: fetch_hash_key(record, :name),
    normalized: normalized_hash_view(record)
  }
end
