# vibe: 1.0

def total_raised_by_currency(donations: array<{ amount: money }>) -> hash<string, money>
  grouped: hash<string, money> = {}
  donations.each { |donation|
    currency = donation["amount"].currency
    current = grouped[currency]
    if current == nil
      current = money("0.00 " + currency)
    end
    grouped[currency] = current + donation["amount"]
  }
  grouped
end

def run -> hash<string, money>
  donations = [
    { amount: money("25.00 USD") },
    { amount: money("50.00 USD") },
    { amount: money("10.00 USD") }
  ]
  total_raised_by_currency(donations)
end
