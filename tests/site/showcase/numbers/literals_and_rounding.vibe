# title: Numeric literals and rounding
# category: Vibescript Showcase
# difficulty: Showcase
# summary: Read hex, octal, binary, and scientific numbers, then round them.
# description: Vibescript uses Ruby-style number literals and helpers for rounding and checking values.
# tags: numbers, literals, math
# vibe: 0.4

def permission_bits -> { execute: int, read: int, read_write: int, write: int }
  {
    read: 0b100,
    write: 0b010,
    execute: 0b001,
    read_write: 0b100 + 0b010
  }
end

def named_sizes -> { hex_flags: int, kilobyte: float, megabyte: float, octal_mode: int }
  {
    kilobyte: 1e3,
    megabyte: 1e6,
    hex_flags: 0xFF00,
    octal_mode: 0o755
  }
end

def rounding(value: float) -> hash<string, number>
  {
    whole: value.round,
    cents: value.round(2),
    down: value.floor,
    up: value.ceil
  }
end

def run -> { is_even: bool, named_sizes: { hex_flags: int, kilobyte: float, megabyte: float, octal_mode: int }, next_id: int, permission_bits: { execute: int, read: int, read_write: int, write: int }, rounding: hash<string, number> }
  {
    permission_bits: permission_bits,
    named_sizes: named_sizes,
    rounding: rounding(3.14159),
    is_even: 42.even?,
    next_id: 41.succ
  }
end
