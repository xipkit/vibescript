# title: Tree traversal
# source: https://rosettacode.org/wiki/Tree_traversal
# category: Rosetta Code
# difficulty: Medium
# summary: Traverse a small binary tree in preorder, inorder, postorder, and level order.
# tags: popular, trees, recursion, data-structures
# vibe: 0.2

class TreeNode
  getter value: string, left: TreeNode?, right: TreeNode?

  def initialize(@value: string, @left: TreeNode?, @right: TreeNode?)
  end
end

def node(value: string, left: TreeNode? = nil, right: TreeNode? = nil) -> TreeNode
  TreeNode.new(value, left, right)
end

def sample_tree -> TreeNode
  node(
    "F",
    node(
      "B",
      node("A"),
      node(
        "D",
        node("C"),
        node("E")
      )
    ),
    node(
      "G",
      nil,
      node(
        "I",
        node("H"),
        nil
      )
    )
  )
end

def preorder(node: TreeNode?) -> array<string>
  if node == nil
    []
  else
    [node.value] + preorder(node.left) + preorder(node.right)
  end
end

def inorder(node: TreeNode?) -> array<string>
  if node == nil
    []
  else
    inorder(node.left) + [node.value] + inorder(node.right)
  end
end

def postorder(node: TreeNode?) -> array<string>
  if node == nil
    []
  else
    postorder(node.left) + postorder(node.right) + [node.value]
  end
end

def level_order(root: TreeNode?) -> array<string>
  if root == nil
    return []
  end

  queue: array<TreeNode> = [root]
  output: array<string> = []
  index = 0

  while index < queue.length
    current = queue.fetch(index)
    output = output.push(current.value)
    left = current.left
    if left != nil
      queue = queue.push(left)
    end
    right = current.right
    if right != nil
      queue = queue.push(right)
    end
    index = index + 1
  end

  output
end

def run -> { inorder: array<string>, level_order: array<string>, postorder: array<string>, preorder: array<string> }
  tree = sample_tree
  {
    preorder: preorder(tree),
    inorder: inorder(tree),
    postorder: postorder(tree),
    level_order: level_order(tree)
  }
end
