# title: Show ASCII table
# source: https://rosettacode.org/wiki/Show_ASCII_table
# category: Rosetta Code
# difficulty: Intro
# summary: Return a compact slice of ASCII rows with code, character, and ordinal data.
# tags: popular, strings, tables, ascii
# vibe: 0.2

def sample_characters -> array<string>
  [" ", "!", "\"", "#", "$", "%", "&", "'", "(", ")", "*", "+"]
end

def build_rows -> array<{ character: string, code: int, printable: bool }>
  rows: array<{ character: string, code: int, printable: bool }> = []
  characters = sample_characters
  index = 0

  while index < characters.length
    symbol = characters.fetch(index)
    rows = rows + [{
      code: symbol.ord,
      character: symbol,
      printable: symbol != " "
    }]
    index = index + 1
  end

  rows
end

def run -> array<{ character: string, code: int, printable: bool }>
  build_rows
end
