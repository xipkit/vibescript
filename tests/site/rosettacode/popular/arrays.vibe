# title: Arrays
# source: https://rosettacode.org/wiki/Arrays
# category: Rosetta Code
# difficulty: Intro
# summary: Create, index, append to, and total arrays.
# tags: popular, arrays, basics, collections
# vibe: 0.4

def run -> { count: int, expanded: array<int>, first: int, last: int, original: array<int>, total: int }
  values = [3, 1, 4]
  expanded = values.dup.push(1, 5, 9)

  {
    original: values,
    expanded: expanded,
    first: expanded.fetch(0),
    last: expanded.fetch(-1),
    count: expanded.length,
    total: expanded.sum
  }
end
