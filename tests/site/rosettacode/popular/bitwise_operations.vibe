# title: Bitwise operations
# source: https://rosettacode.org/wiki/Bitwise_operations
# category: Rosetta Code
# difficulty: Medium
# summary: Run common bitwise operations with a hand-built 8-bit model.
# tags: popular, math, bits, arrays
# vibe: 0.2

def divmod2(value: int) -> { quotient: int, remainder: int }
  quotient = 0
  remainder = value

  while remainder >= 2
    quotient = quotient + 1
    remainder = remainder - 2
  end

  {
    quotient: quotient,
    remainder: remainder
  }
end

def to_bits(value: int, width: int) -> array<int>
  bits: array<int> = []
  current = value
  index = 0

  while index < width
    pair = divmod2(current)
    bits = [pair["remainder"]] + bits
    current = pair["quotient"]
    index = index + 1
  end

  bits
end

def from_bits(bits: array<int>) -> int
  value = 0
  index = 0

  while index < bits.length
    value = (value * 2) + bits.fetch(index)
    index = index + 1
  end

  value
end

def normalize_rotate(amount: int, width: int) -> int
  shift = amount
  while shift >= width
    shift = shift - width
  end
  shift
end

def bitwise_and(left_bits: array<int>, right_bits: array<int>) -> array<int>
  output: array<int> = []
  index = 0

  while index < left_bits.length
    if left_bits[index] == 1 && right_bits[index] == 1
      output = output.push(1)
    else
      output = output.push(0)
    end
    index = index + 1
  end

  output
end

def bitwise_or(left_bits: array<int>, right_bits: array<int>) -> array<int>
  output: array<int> = []
  index = 0

  while index < left_bits.length
    if left_bits[index] == 1 || right_bits[index] == 1
      output = output.push(1)
    else
      output = output.push(0)
    end
    index = index + 1
  end

  output
end

def bitwise_xor(left_bits: array<int>, right_bits: array<int>) -> array<int>
  output: array<int> = []
  index = 0

  while index < left_bits.length
    if left_bits[index] != right_bits[index]
      output = output.push(1)
    else
      output = output.push(0)
    end
    index = index + 1
  end

  output
end

def bitwise_not(bits: array<int>) -> array<int>
  output: array<int> = []
  index = 0

  while index < bits.length
    if bits[index] == 1
      output = output.push(0)
    else
      output = output.push(1)
    end
    index = index + 1
  end

  output
end

def shift_left(bits: array<int>, amount: int) -> array<int>
  output: array<int> = []
  index = amount

  while index < bits.length
    output = output.push(bits.fetch(index))
    index = index + 1
  end

  while output.length < bits.length
    output = output.push(0)
  end

  output
end

def shift_right_logical(bits: array<int>, amount: int) -> array<int>
  output: array<int> = []
  index = 0

  while index < amount
    output = output.push(0)
    index = index + 1
  end

  limit = bits.length - amount
  index = 0
  while index < limit
    output = output.push(bits.fetch(index))
    index = index + 1
  end

  output
end

def shift_right_arithmetic(bits: array<int>, amount: int) -> array<int>
  output: array<int> = []
  sign = bits.fetch(0)
  index = 0

  while index < amount
    output = output.push(sign)
    index = index + 1
  end

  limit = bits.length - amount
  index = 0
  while index < limit
    output = output.push(bits.fetch(index))
    index = index + 1
  end

  output
end

def rotate_left(bits: array<int>, amount: int) -> array<int>
  shift = normalize_rotate(amount, bits.length)
  output: array<int> = []
  index = shift

  while index < bits.length
    output = output.push(bits.fetch(index))
    index = index + 1
  end

  index = 0
  while index < shift
    output = output.push(bits.fetch(index))
    index = index + 1
  end

  output
end

def rotate_right(bits: array<int>, amount: int) -> array<int>
  shift = normalize_rotate(amount, bits.length)
  cut = bits.length - shift
  output: array<int> = []
  index = cut

  while index < bits.length
    output = output.push(bits.fetch(index))
    index = index + 1
  end

  index = 0
  while index < cut
    output = output.push(bits.fetch(index))
    index = index + 1
  end

  output
end

def to_signed(value: int, width: int) -> int
  sign_bit = 1
  index = 1

  while index < width
    sign_bit = sign_bit * 2
    index = index + 1
  end

  limit = sign_bit * 2
  if value >= sign_bit
    value - limit
  else
    value
  end
end

def run -> hash<string, int | string>
  width = 8
  x = 177
  y = 3
  x_bits = to_bits(x, width)
  y_bits = to_bits(y, width)

  {
    model: "manual 8-bit operations",
    x: x,
    x_signed: to_signed(x, width),
    y: y,
    and: from_bits(bitwise_and(x_bits, y_bits)),
    or: from_bits(bitwise_or(x_bits, y_bits)),
    xor: from_bits(bitwise_xor(x_bits, y_bits)),
    not: from_bits(bitwise_not(x_bits)),
    shift_left: from_bits(shift_left(x_bits, y)),
    shift_right: from_bits(shift_right_logical(x_bits, y)),
    shift_right_arithmetic: to_signed(from_bits(shift_right_arithmetic(x_bits, y)), width),
    rotate_left: from_bits(rotate_left(x_bits, y)),
    rotate_right: from_bits(rotate_right(x_bits, y))
  }
end
