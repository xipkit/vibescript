# title: Set
# source: https://rosettacode.org/wiki/Set
# category: Rosetta Code
# difficulty: Intro
# summary: Find the union, intersection, and difference of array-backed sets.
# tags: popular, arrays, sets, basics

def set_union(left: array<int>, right: array<int>) -> array<int>
  (left + right).uniq
end

def set_intersection(left: array<int>, right: array<int>) -> array<int>
  left.select { |value|
    right.include?(value)
  }
end

def set_difference(left: array<int>, right: array<int>) -> array<int>
  left - right
end

def run -> { difference: array<int>, intersection: array<int>, union: array<int> }
  left = [1, 2, 3, 4]
  right = [3, 4, 5, 6]

  {
    union: set_union(left, right),
    intersection: set_intersection(left, right),
    difference: set_difference(left, right)
  }
end
