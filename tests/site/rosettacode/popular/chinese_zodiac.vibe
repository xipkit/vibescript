# title: Chinese zodiac
# source: https://rosettacode.org/wiki/Chinese_zodiac
# category: Rosetta Code
# difficulty: Intro
# summary: Map sample years to their Chinese zodiac animal and element.
# tags: popular, dates, lookup, basics
# vibe: 0.2

def positive_mod(value: int, divisor: int) -> int
  result = value % divisor
  if result < 0
    result + divisor
  else
    result
  end
end

def zodiac(year: int) -> { animal: string, element: string, year: int }
  animals = ["Rat", "Ox", "Tiger", "Rabbit", "Dragon", "Snake", "Horse", "Goat", "Monkey", "Rooster", "Dog", "Pig"]
  elements = ["Metal", "Metal", "Water", "Water", "Wood", "Wood", "Fire", "Fire", "Earth", "Earth"]
  offset = year - 2020

  {
    year: year,
    animal: animals.fetch(positive_mod(offset, 12)),
    element: elements.fetch(positive_mod(offset, 10))
  }
end

def run -> array<{ animal: string, element: string, year: int }>
  [
    zodiac(2020),
    zodiac(2024),
    zodiac(2026),
    zodiac(1984)
  ]
end
