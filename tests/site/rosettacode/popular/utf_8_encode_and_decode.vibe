# title: UTF-8 encode and decode
# source: https://rosettacode.org/wiki/UTF-8_encode_and_decode
# category: Rosetta Code
# difficulty: Medium
# summary: Encode fixed code points into UTF-8 byte arrays and decode them back.
# tags: popular, strings, encoding, unicode
# vibe: 0.2

def utf8_encode(code_point: int) -> array<int>
  if code_point < 128
    [code_point]
  elsif code_point < 2048
    [192 + (code_point // 64), 128 + (code_point % 64)]
  elsif code_point < 65536
    [
      224 + (code_point // 4096),
      128 + ((code_point // 64) % 64),
      128 + (code_point % 64)
    ]
  else
    [
      240 + (code_point // 262144),
      128 + ((code_point // 4096) % 64),
      128 + ((code_point // 64) % 64),
      128 + (code_point % 64)
    ]
  end
end

def utf8_decode(bytes: array<int>) -> int
  if bytes.length == 1
    bytes.fetch(0)
  elsif bytes.length == 2
    ((bytes.fetch(0) - 192) * 64) + (bytes.fetch(1) - 128)
  elsif bytes.length == 3
    ((bytes.fetch(0) - 224) * 4096) + ((bytes.fetch(1) - 128) * 64) + (bytes.fetch(2) - 128)
  else
    ((bytes.fetch(0) - 240) * 262144) + ((bytes.fetch(1) - 128) * 4096) + ((bytes.fetch(2) - 128) * 64) + (bytes.fetch(3) - 128)
  end
end

def run -> array<{ bytes: array<int>, code_point: int, decoded: int }>
  code_points = [36, 162, 8364, 128578]
  rows: array<{ bytes: array<int>, code_point: int, decoded: int }> = []
  index = 0

  while index < code_points.length
    code_point = code_points.fetch(index)
    bytes = utf8_encode(code_point)
    rows = rows.push({
      code_point: code_point,
      bytes: bytes,
      decoded: utf8_decode(bytes)
    })
    index = index + 1
  end

  rows
end
