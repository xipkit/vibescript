      "界🙂",
      "é界🙂",
      "aé界",
      "🙂z",
      "",
      null,
      null
    ]
  },
  {
    "name": "byte_access",
    "body": "s=\"aé界🙂\"\n[s.getbyte(1),s.getbyte(-1),s.getbyte(10),s.getbyte(-11),s.byteslice(1,2),s.byteslice(3..5),s.byteslice(-4,4),s.byteslice(10,1),s.byteslice(11,0)]",
    "expected": [
      195,
      130,
      null,
      null,
      "é",
      "界",
      "🙂",
      "",
      null
    ]
  },
  {
    "name": "empty_slices",
    "body": "[[][0],[][0,0],[][..3],[][-1..2],\"\".slice(0),\"\"[0,0],\"\".byteslice(0,0)]",
    "expected": [
      null,
      [],
      [],
      null,
      null,
      "",
      ""
    ]
  },
  {
    "name": "string_slice_invalid",
    "body": "s=\"a\\xff\\xc3é\"\n[s[1].bytesize,s.slice(1).bytesize,s[1,2].bytesize,s[1..2].bytesize,s.byteslice(1).bytesize,s.slice(1,3)]",
    "expected": [
      3,
      3,
      6,
      6,
      1,
      "��é"
    ]
  },
  {
    "name": "string_slice_substring",
    "body": "s=\"aé界🙂\"\n[s.slice(\"é界\"),s.slice(\"界\"),s.slice(\"z\"),s.slice(\"\")]",
    "expected": [
      "é界",
      "界",
      null,
      ""
    ]
  }
