        3,
        4
      ],
      [],
      [],
      null,
      null,
      [
        1,
        2
      ],
      [
        3,
        4
      ]
    ]
  },
  {
    "name": "array_slice_aliases",
    "body": "a=[1,2,3,4]\nb=a.slice(1,2)\nc=b\nb.push(9)\nb[0]=7\n[a,b,c]",
    "expected": [
      [
        1,
        2,
