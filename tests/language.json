  {
    "name": "string_slice_unicode",
    "body": "s=\"aé界🙂z\"\n[s.slice(1),s[1,3],s.slice(-3,2),s[1..-2],s[..2],s[3...],s.slice(5,9),s[6,0],s.slice(2,-1)]",
    "expected": [
